{
  "name": "m3finance",
  "version": "7.2.0",
  "private": true,
  "description": "M3 Finance: controle financeiro pessoal (lançamentos, cartões, faturas, contas, relatórios)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "vercel-build": "prisma generate && prisma migrate deploy && prisma db seed && next build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^2.4.3",
    "next": "^14.2.30",
    "next-auth": "^4.24.11",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "zod": "^3.23.8",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dotenv": "^16.4.5",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.19"
  }
