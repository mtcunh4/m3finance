# Copie para .env para rodar no computador. Na Vercel, cadastre em Settings › Environment Variables.

# Banco (Neon). Na Vercel, a ligação com o Neon (prefixo DATABASE) cria estas variáveis sozinha.
DATABASE_URL="postgresql://usuario:senha@servidor/m3finance?sslmode=require"
DIRECT_URL=""

# Login (texto aleatório e longo)
NEXTAUTH_SECRET="troque-por-um-texto-aleatorio-e-longo"
NEXTAUTH_URL="http://localhost:3000"

# Seu acesso, criado na primeira publicação
SEED_ADMIN_EMAIL="voce@exemplo.com"
SEED_ADMIN_NAME="Seu nome"
SEED_DEFAULT_PASSWORD="SenhaProvisoria2026"
# Esqueceu a senha? Coloque true, publique de novo (a senha volta a ser SEED_DEFAULT_PASSWORD) e depois apague
SEED_RESET_PASSWORD=""

# Backups na nuvem (Vercel Blob). Na Vercel, a ligação do Blob cria BLOB_STORE_ID sozinha.
# Sem ela, no computador, os backups vão para a pasta ./storage/backups
BLOB_STORE_ID=""
